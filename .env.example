# ===== 复制为 .env 并填入真实值；.env 不会提交到仓库 =====
# 本文件与 backend/app/config.py 的 Settings 字段一一对应（每项均有默认值，开发可直接用）。
# 仅三家属地的 API Key 必须自行填入，其余基础设施默认值已对齐 docker-compose。

# ---------- 应用 ----------
APP_NAME=电网运维 RAG 智能问答系统
APP_VERSION=0.1.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
API_PREFIX=/api
DEBUG=true

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=grid_qa
MYSQL_USER=grid
MYSQL_PASSWORD=grid123456
MYSQL_HOST=localhost
MYSQL_PORT=3307
# 后端连接串（aiomysql 异步驱动；宿主机映射 3307，避开本机已装的 MySQL）
DATABASE_URL=mysql+aiomysql://grid:grid123456@localhost:3307/grid_qa?charset=utf8mb4

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=grid-documents
MINIO_SECURE=false

# ---------- JWT ----------
JWT_SECRET=please-change-this-to-a-random-long-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 默认管理员（首次启动自动创建）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- 模型 Provider（云 API）----------
# LLM 可切换：deepseek | qwen | doubao
LLM_PROVIDER=deepseek
# L2 query 特征分档（turbo/plus 两档模型映射，见 /api/system/config/llm-router 热配置）
LLM_TIER_ENABLE=false
# 关=现状(事实短问走 plus 质量档)；开=低推理短问走 turbo(实测 7.4s vs 15.2s 同 grade)
LLM_TIER_FACT_FAST_ENABLE=false
# Embedding 可切换：qwen | doubao （DeepSeek 无 embedding 接口）
EMB_PROVIDER=qwen
# 向量维度固定 1024（两家 embedding 统一对齐；切换 provider 需重建 Milvus collection）
EMBEDDING_DIM=1024

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 阿里百炼 DashScope（OpenAI 兼容）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus
QWEN_EMB_MODEL=text-embedding-v3

# --- 火山方舟 Ark（OpenAI 兼容；model 字段传 endpoint_id）---
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_LLM_ENDPOINT_ID=
DOUBAO_EMB_MODEL=doubao-embedding-text-240815

# ---------- Milvus（双 collection，向量空间隔离）----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=grid_chunks              # 云 embedding(1024维)向量库
MILVUS_COLLECTION_BGE=grid_chunks_bge      # 本地 bge(512维)向量库，独立 collection 向量空间不混

# ---------- Redis（热点问答缓存 + 配置持久化 + query 向量缓存）----------
# ⚠️ docker-compose 的 redis 起了 --requirepass（见 compose command 行）；
# 本机直连（uvicorn 本地开发 / eval_matrix 变体后端）必须带密码，否则
# hotqa/语义缓存/黑名单/改写缓存全链路 AuthenticationError 降级——评测结论被毒化。
REDIS_URL=redis://:grid-langfuse-pass@localhost:6379/0
QA_CACHE_TTL=3600

# ---------- Neo4j（知识图谱：设备-故障-处置 多跳推理）----------
# 与 docker-compose 的 NEO4J_AUTH 一致；本机访问用 localhost，容器内用 bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456
KG_RAG_ENABLE=true   # 问答时融合知识图谱结构化上下文(GraphRAG)；关则纯文档检索
# KG 每日对账 cron（MySQL 镜像 vs Neo4j 边数，漂移>5 WARN + grid_kg_drift_triples 指标；<=0 关）
KG_RECONCILE_CRON_HOURS=24

# ---------- 重排（rerank）----------
RERANK_ENABLE=true
RERANK_MODEL=gte-rerank-v2

# ---------- 检索质量 ----------
MMR_ENABLE=true            # MMR 多样性重排
MMR_LAMBDA=0.6             # 相关性 vs 多样性 权衡
QUERY_REWRITE_ENABLE=false # LLM 改写 query（增一次 LLM 调用延迟，默认关）
BGE_MODEL=BAAI/bge-small-zh-v1.5   # 可换 bge-large-zh-v1.5(1024维,效果更好)
BGE_DIM=512
DOC_SIZE_THRESHOLD=5000    # 文档总字数超此值 → 走云 embedding；否则本地 bge

# ---------- 分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- Corrective RAG（检索自纠错闭环）----------
CRAG_ENABLE=true          # 检索后分级+纠错(低相关触发query改写重检索/拒答)
CRAG_HIGH=0.6             # top1 rerank分>=此值=correct(证据充分)
CRAG_LOW=0.3              # top1 rerank分<此值=incorrect(触发纠错)
CRAG_PERDOC_ENABLE=false  # CRAG v2：LLM 逐条评估证据相关性（增延迟，默认关，按需开）

# ---------- 结构感知分块 + Parent-Child（small-to-big）----------
SMALL_TO_BIG_ENABLE=true  # 检索小块、召回同组大块上下文（解决长规程跨块/表格被切）
PARENT_SIZE=2000          # 父块（大块，生成上下文）目标字数
PARENT_OVERLAP=200

# ---------- 检索增强（2026 RAG 趋势，默认关，按需开）----------
HYDE_ENABLE=false         # HyDE：LLM 生成假设答案再做向量检索（短/口语问题提升召回）
MULTI_QUERY_ENABLE=false  # 多查询分解：复杂问题拆子问题并行检索
SELF_RAG_ENABLE=false     # Self-RAG（预留开关）
STANDALONE_REWRITE_ENABLE=true  # 多轮指代消解：追问改写为带上下文独立查询

# ---------- 安全合规（电网强监管）----------
SAFETY_FILTER_ENABLE=true # 入站 prompt injection 告警（计数，不阻断，避免误杀）
INJECTION_GUARD_STRICT_ENABLE=false # 高危注入(指令覆盖类)QA侧直接结构化拒答（关=现状只告警；开=拦截，缓存版本含此档）
PII_MASK_ENABLE=false     # 出站答案敏感信息脱敏（手机/身份证/密码，按合规要求开）
HIGH_RISK_KEYWORDS=停电,拉闸,合闸,接地,挂地线,带电,登高,攀登,放电,倒闸

# ---------- 实时事件接入（SCADA / OMS / PMS）----------
# 必须与 grafana/provisioning/alerting/contactpoints.yml 的 token 完全一致；为空时 webhook 503 拒绝接入
ALERT_WEBHOOK_TOKEN=grid-alert-token-2026
ALERT_WEBHOOK_TENANT=default
# 单连接器凭据只授权此租户；HMAC 签名内容为 timestamp.tenant_id.raw_body。
REALTIME_EVENT_CREDENTIAL_TENANT=default
REALTIME_EVENT_TOKEN=please-change-realtime-ingress-token
REALTIME_EVENT_SIGNING_SECRET=please-change-realtime-hmac-secret
# 多租户连接器可改用 JSON 映射；未配置的租户拒绝接入。
REALTIME_EVENT_TENANT_TOKENS={}
REALTIME_EVENT_TENANT_SIGNING_SECRETS={}

# ---------- 可信度评测（真 faithfulness，替代粗糙启发式）----------
ONLINE_FAITHFULNESS_ENABLE=true  # 线上答案异步 LLM-judge，前端拉取覆盖"幻觉率"展示
FAITHFULNESS_GATE=0.85           # 生成质量门禁：平均支撑率阈值（scripts/eval_generation.py 用）

# ---------- 多模态 RAG（VLM 图片理解）----------
VLM_ENABLE=false            # VLM 理解图片(图纸/设备/故障现象)补充 OCR 丢失的空间语义
QWEN_VLM_MODEL=qwen-vl-max

# ---------- Self-RAG（检索必要性判断）----------
SELF_RAG_ENABLE=false      # LLM 路由：非运维问题跳过检索直接拒答（省成本+防污染）

# ---------- 配置中心 Nacos（可选，默认 .env）----------
# CONFIG_SOURCE=nacos 时启动从 Nacos 拉取覆盖 .env（docker compose up -d nacos 起服务）
CONFIG_SOURCE=env
NACOS_SERVER=http://localhost:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=grid-qa.properties

# ---------- 检索参数调优（只建议模式）----------
TUNE_ENABLE=true            # 调参扫描总开关
TUNE_MIN_IMPROVE=0.02       # 出建议的最小提升（防噪声）
TUNE_MIN_SAMPLE=10          # 最小有效样本（防小样本过拟合）
TUNE_SCAN_TOPK=5            # 扫描评测用 topk

# ---------- 质量数据飞轮（默认关=现状；opt-in 通电逐步开）----------
# 总线总开关：emit 入库恒做；开=异步派发订阅者(dislike→补全 / 文档下架→清缓存 / 评测低分→调参)
QUALITY_BUS_ENABLE=false
# dislike 坏 case → evidence_gap 补全闭环（飞轮核心；feedback_fix_rate=转速）
DISLIKE_TO_GAP_ENABLE=false
# 评测低分 → retrieval_tune 扫描触发调参建议（较重，二期再开）
EVAL_TO_TUNE_ENABLE=false
# 治理联动清理 Milvus/Neo4j/qa_cache（opt-in；误删风险高，务必先开 dry-run）
GOVERNANCE_PROPAGATE_ENABLE=false
# A4 安全阀：开=doc_blocked 只产出候选清理报告(质量事件)不删除，确认后调 POST /system/governance-propagate/execute；关=事件直接真实清理
GOVERNANCE_PROPAGATE_DRY_RUN_ENABLE=false

# ---------- MCP 外部 server（N2 总线数据源；mock SCADA 默认侧车）----------
# JSON 串；compose 内 backend 改用 http://mock-scada:9100（service-name）
MCP_SERVERS=[{"name":"mock_scada","url":"http://localhost:9100"}]
# MCP 治理：总开关（关=禁用全部外部 server）/ server 白名单（逗号分隔，空=全部允许）
MCP_EXTERNAL_ENABLED=true
MCP_PROVIDER_ALLOWLIST=
# MCP 超时（秒）：连接 / 工具发现 / 工具调用
MCP_CONNECT_TIMEOUT_SECONDS=2.0
MCP_DISCOVERY_TIMEOUT_SECONDS=10.0
MCP_CALL_TIMEOUT_SECONDS=30.0

# ---------- Agent 长期记忆治理 ----------
# 全局自动沉淀开关（false=仅用户显式 opt-in 才写长期记忆；召回需 memoryRead 同意）
MEMORY_AUTO_SAVE_ENABLED=false

# ---------- 问答→行动闭环（默认关=现状；开=Agent 可落库工单+ops_planner persona+工单流转事件）----------
TICKET_ACTION_LOOP_ENABLE=false

# ---------- 主动运维闭环补全（默认关=现状；结构化根因+遥测证据+闭环回填）----------
PROACTIVE_SCHEMA_V2_ENABLE=false  # 开=proactive_diagnosis persona 输出 schema v2；关=用 alert persona（现状）
PROACTIVE_TELEMETRY_ENABLE=false  # 开=诊断可拉 mock_scada 实时遥测作证据；关=现状
PROACTIVE_FEEDBACK_ENABLE=false  # 开=流转结果回填 quality_events；关=现状

# ---------- QA 主链路增强（接通旁支能力，opt-in 默认关=现状）----------
DEBATE_ON_LOW_CONFIDENCE_ENABLE=false  # 低置信(medium_low/low/refused)→debate_agent 三专家裁决注入答案+升置信
SUFFICIENCY_GATE_ENABLE=false           # judge.answerability 判证据不足→置信降一档(与 DEBATE 闭环)

# ---------- 链路 trace 可视化（per-request 瀑布图，定位"卡在哪个节点"）----------
QA_TRACE_DETAIL_ENABLE=false  # 节点详情采集(参数/prompt attrs; 关=现状只记耗时; 纯观测不进缓存版本)
QA_TRACE_PROMPT_CHARS=1200    # 单段 prompt/输出截断长度

# ---------- LLM as a User 可选旁路探针（默认关闭；Secret 仅从部署环境注入）----------
LLM_USER_OBSERVER_ENABLED=false
LLM_USER_OBSERVER_CAPTURE_TEXT=false
LLM_USER_OBSERVER_USER_HASH_SECRET=
LLM_USER_OBSERVER_QUEUE_SIZE=2048
LLM_USER_OBSERVER_BATCH_SIZE=256
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# langfuse OTLP 鉴权（Basic Auth，双双非空才带头；scripts/langfuse_bootstrap.py 生成或 UI 创建）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LLM_USER_CALLBACK_SECRET=
LLM_USER_CALLBACK_MAX_SKEW_SECONDS=300
LLM_USER_SUITE_EVENT_URL=
LLM_USER_SUITE_EVENT_SECRET=
# 独立运维工作台（默认关闭，不改变既有问答链路；无设备控制）
OPS_WORKBENCH_ENABLE=false

# N7 运维报告智能生成（默认关闭；聚合交接班/遥测/两票/告警/预测→LLM 报告→Word 导出）
OPS_REPORT_ENABLE=false
OPS_REPORT_MAX_DAYS=31

# 文档协作批注 + 电子签批（默认关闭；锚点批注/回复/解决 + 多人会签流+哈希链留痕）
DOC_COLLAB_ENABLE=false

# N5 故障仿真演练沙箱（默认关闭；剧本 CRUD/孪生故障链生成/时间轴推演/评分+AI 复盘）
DRILL_SANDBOX_ENABLE=false
DRILL_MAX_DURATION_SECONDS=3600
